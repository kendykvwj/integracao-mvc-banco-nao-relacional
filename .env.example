# Copie este arquivo para .env e preencha com a sua string de conexao.
# Atlas: botao Connect > Drivers > Python > copiar URI.
# Troque <db_password> pela senha real do usuario criado em Database Access.
# Se a senha tiver caracteres especiais (@ : / ? # [ ] %), faca URL-encode.
MONGODB_URI=mongodb+srv://USUARIO:SENHA@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
# Nome do banco (default: biblioteca)
MONGODB_DB=biblioteca
